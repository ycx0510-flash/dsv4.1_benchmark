diff --git a/deepinfer/environ.py b/deepinfer/environ.py
index e3a55bb..48f5e45 100644
--- a/deepinfer/environ.py
+++ b/deepinfer/environ.py
@@ -20,6 +20,13 @@ def _bool(v: str | None, default: str = "0") -> bool:
     raise ValueError("expected one of '0', '1', 'false', 'true' (case-insensitive)")
 
 
+def _engram_force_gpu_storage(v: str | None) -> bool:
+    """Ascend defaults the Engram tables to device memory; an explicit false keeps them on the host."""
+    if v is not None and v.strip().lower() in ("0", "false", "off", "no"):
+        return False
+    return _bool(v) or envs.DEEPINFER_ACCELERATOR == "ascend"
+
+
 def _int(v: str | None, default: int = 0) -> int:
     return int(v if v is not None else str(default))
 
@@ -151,7 +158,7 @@ class envs:
 
     # -- Model Loading --
     DEEPINFER_ENGRAM_PAD_TOKEN = EnvVar.int(default=2)
-    DEEPINFER_ENGRAM_FORCE_GPU_STORAGE = EnvVar(lambda v: _bool(v) or envs.DEEPINFER_ACCELERATOR == "ascend")
+    DEEPINFER_ENGRAM_FORCE_GPU_STORAGE = EnvVar(_engram_force_gpu_storage)
 
     # -- Sampling --
     DEEPINFER_SAMPLER_FORCE_TOPK = EnvVar.int()
